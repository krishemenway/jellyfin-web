{
	"compilerOptions": {
		"paths": {
			"*": ["./*"],
		},
		"sourceRoot": "./",
		"outDir": "./dist/",
		"noImplicitAny": true,
		"strict": true,
		"module": "commonjs",
		"target": "esnext",
		"jsx": "react",
		"sourceMap": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"resolveJsonModule": true,
	},
}